<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.comdis.p2p.client.ChatView?>

<TabPane
        tabDragPolicy="FIXED"
        tabClosingPolicy="UNAVAILABLE"
        xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.comdis.p2p.client.MainWindowController">

    <!-- =========================================================================================================== -->

    <Tab text="Chats">
        <SplitPane fx:id="splitPane">

            <ListView fx:id="contacts"/>

            <StackPane>
                <VBox fx:id="chatPane" styleClass="background-panel">
                    <!-- Este contenido se cambiara una vez que se seleccione un chat -->
                    <Label fx:id="lblTip" text="Seleccione un contacto"/>

                    <!--
                    <Label fx:id="lblChatName" text="Jimmy"/>
                    <StackPane fx:id="chat">
                        <ChatView fx:id="chat" VBox.vgrow="ALWAYS" styleClass="background-panel"/>
                        ...
                    </StackPane>
                    <HBox styleClass="toolbar">
                        <TextField fx:id="inputMsg" HBox.hgrow="ALWAYS" promptText="Escribe un mensaje"/>
                        <Button onAction="#sendMessage" text="Enviar"/>
                    </HBox>
                    -->
                </VBox>
            </StackPane>
        </SplitPane>
    </Tab>

    <!-- =========================================================================================================== -->

    <Tab text="Añadir amigos">
        <VBox styleClass="background-panel">
            <HBox styleClass="toolbar">
                <TextField fx:id="inputSearchUsers" HBox.hgrow="ALWAYS" promptText="Buscar usuarios"/>
                <Button mnemonicParsing="false" onAction="#searchUsers" text="Buscar"/>
                <Button mnemonicParsing="false" onAction="#sendFriendRequest" text="Agregar"/>
            </HBox>
            <ListView fx:id="searchResult" onMouseClicked="#printsSelectedUser" VBox.vgrow="ALWAYS"/>
        </VBox>
    </Tab>

    <!-- =========================================================================================================== -->

    <Tab text="Solicitudes">
        <VBox styleClass="background-panel">
            <ListView fx:id="pendingRequests" VBox.vgrow="ALWAYS"/>
            <HBox styleClass="toolbar">
                <Button mnemonicParsing="false" onAction="#acceptFriendRequest" text="Aceptar"/>
                <Button mnemonicParsing="false" onAction="#rejectFriendRequest" text="Rechazar"/>
            </HBox>
        </VBox>
    </Tab>

    <!-- =========================================================================================================== -->

    <Tab text="Ajustes">
        <VBox styleClass="background-panel">
            <Label text="Ajustes" styleClass="title"/>
            <GridPane fx:id="changePasswordForm">
                <Label GridPane.rowIndex="1" GridPane.columnIndex="1" text="Contraseña antigua:"/>
                <PasswordField GridPane.rowIndex="1" GridPane.columnIndex="2" fx:id="inputOldPassword"/>

                <Label GridPane.rowIndex="2" GridPane.columnIndex="1" text="Contraseña nueva:"/>
                <PasswordField GridPane.rowIndex="2" GridPane.columnIndex="2" fx:id="inputNewPassword1"/>

                <Label GridPane.rowIndex="3" GridPane.columnIndex="1" text="Repetir contraseña nueva:"/>
                <PasswordField GridPane.rowIndex="3" GridPane.columnIndex="2" fx:id="inputNewPassword2"/>
            </GridPane>
            <Label visible="false" styleClass="error" visible="false" fx:id="inputFailed"/>
            <Button text="Cambiar" styleClass="btn" onAction="#changePassword"/>
        </VBox>
    </Tab>
</TabPane>
